{
  "manifest_version": 3,
  "name": "115m for Firefox Android",
  "description": "115m | Firefox Android 适配版：列表预览图 + 无损播放",
  "version": "1.8.8",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "cookies",
    "scripting",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "https://115.com/*",
    "https://*.115.com/*",
    "https://webapi.115.com/*",
    "https://proapi.115.com/*",
    "https://dl.115cdn.net/*",
    "https://115vod.com/*",
    "https://*.115vod.com/*"
  ],
  "action": {
    "default_title": "115m Firefox Android",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.115.com/*",
        "*://115.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_end",
      "js": [
        "content-scripts/home.js"
      ]
    },
    {
      "matches": [
        "*://*.115.com/web/lixian/master/video/*",
        "*://115.com/web/lixian/master/video/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": [
        "content-scripts/video-page.js"
      ]
    },
    {
      "matches": [
        "https://*.115vod.com/*",
        "https://115vod.com/*"
      ],
      "run_at": "document_end",
      "js": [
        "content-scripts/vod-fullscreen.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content-scripts/video-page.css"
      ],
      "use_dynamic_url": true,
      "matches": [
        "*://*.115.com/*",
        "*://115.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "115m-firefox-android@example.com",
      "strict_min_version": "121.0"
    },
    "gecko_android": {}
  }
}
